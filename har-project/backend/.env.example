# Copy this file to .env and fill in your values.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers -> Python)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=har_db
# true = in-memory demo database (no Atlas needed, data lost on restart)
USE_MOCK_DB=false

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_HOURS=24

# Frontend origin(s), comma separated
CORS_ORIGINS=http://localhost:5173

# true = skip TensorFlow and use the lightweight mock model
FORCE_MOCK_MODEL=false

PORT=5000
